# ---------------------------------------------------------------------------
# CopiPilot environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Database (PostgreSQL)
DATABASE_URL="postgresql://copipilot:CHANGE_ME@localhost:5433/copipilot?schema=public"
TEST_DATABASE_URL="postgresql://copipilot:CHANGE_ME@localhost:5433/copipilot_test?schema=public"

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="CHANGE_ME_32_BYTES_HEX"
AUTH_URL="http://localhost:3400"
NEXT_PUBLIC_SITE_URL="http://localhost:3400"

# Initial administrator (created/updated by the seed). Change the password after first login.
ADMIN_EMAIL="admin@copipilot.com"
ADMIN_PASSWORD="ChangeMe-Admin-123!"
ADMIN_NAME="CopiPilot Admin"

# Uploads
UPLOAD_STORAGE="local"
UPLOAD_DIR="./public/uploads"
MAX_UPLOAD_MB="5"

# Email (optional — leave blank to disable outbound email)
EMAIL_HOST=""
EMAIL_PORT="587"
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM="CopiPilot <no-reply@copipilot.com>"

# Analytics (optional)
NEXT_PUBLIC_GA_ID=""
