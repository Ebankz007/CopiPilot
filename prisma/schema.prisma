// CopiPilot — Prisma schema (PostgreSQL)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/* ------------------------------------------------------------------ enums */

enum AdminRole {
  SUPER_ADMIN
  CONTENT_ADMIN
  SUPPORT_ADMIN
  FINANCE_ADMIN
}

enum UserRole {
  CLIENT
  AFFILIATE
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum NavLocation {
  HEADER
  FOOTER
}

enum MessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum StrategyStatus {
  ACTIVE
  INACTIVE
  COMING_SOON
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum InvestmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  INVESTMENT
  PROFIT
  FEE
  REFUND
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  APPROVED
  COMPLETED
  REJECTED
  FAILED
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  CRYPTO
  WALLET
  OTHER
}

enum NotificationType {
  SYSTEM
  INVESTMENT
  DEPOSIT
  WITHDRAWAL
  SECURITY
}

/* --------------------------------------------------------------- identity */

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(CONTENT_ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions          AdminSession[]
  resets            PasswordReset[]
  auditLogs         AuditLog[]
  reviewedDeposits  Deposit[]     @relation("DepositReviewer")
  reviewedWithdraws Withdrawal[]  @relation("WithdrawalReviewer")

  @@index([email])
  @@index([role])
}

model AdminSession {
  id        String   @id @default(cuid())
  adminId   String
  tokenHash String   @unique
  ip        String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String
  fullName        String
  phone           String?
  country         String?
  role            UserRole   @default(CLIENT)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sessions      UserSession[]
  resets        PasswordReset[]
  investments   Investment[]
  deposits      Deposit[]
  withdrawals   Withdrawal[]
  transactions  Transaction[]
  notifications Notification[]

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  ip        String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordReset {
  id        String    @id @default(cuid())
  email     String
  scope     String    @default("user") // "user" | "admin"
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  adminId String?
  admin   Admin?  @relation(fields: [adminId], references: [id], onDelete: SetNull)
  userId  String?
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([scope])
}

/* ------------------------------------------------------------- strategies */

model Strategy {
  id               String         @id @default(cuid())
  slug             String         @unique
  name             String
  shortDescription String         @db.Text
  description      String         @db.Text
  minInvestment    Float          @default(0)
  maxInvestment    Float?
  targetReturn     Float? // displayed as a percentage, illustrative only
  returnPeriod     String?        @default("monthly")
  durationMonths   Int?
  riskLevel        RiskLevel      @default(MEDIUM)
  strategyType     String         @default("Automated")
  profitFactor     Float?
  maxDrawdown      Float?
  status           StrategyStatus @default(ACTIVE)
  isFeatured       Boolean        @default(false)
  icon             String?
  imageUrl         String?
  ctaLabel         String         @default("Get started")
  ctaUrl           String?        @default("/register")
  terms            String?        @db.Text
  metrics          Json?
  order            Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  investments Investment[]

  @@index([status, order])
  @@index([isFeatured])
}

model Investment {
  id             String           @id @default(cuid())
  userId         String
  strategyId     String
  amount         Float
  status         InvestmentStatus @default(PENDING)
  durationMonths Int?
  startedAt      DateTime?
  maturesAt      DateTime?
  profitLoss     Float            @default(0)
  referenceId    String           @unique
  notes          String?          @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([strategyId])
  @@index([status])
  @@index([createdAt])
}

/* ------------------------------------------------------------- finance ---- */

model Deposit {
  id           String            @id @default(cuid())
  userId       String
  amount       Float
  currency     String            @default("USD")
  method       PaymentMethod     @default(BANK_TRANSFER)
  reference    String?
  status       TransactionStatus @default(PENDING)
  adminNote    String?           @db.Text
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy Admin? @relation("DepositReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Withdrawal {
  id           String            @id @default(cuid())
  userId       String
  amount       Float
  currency     String            @default("USD")
  method       PaymentMethod     @default(BANK_TRANSFER)
  destination  String? // wallet address / bank details reference
  status       TransactionStatus @default(PENDING)
  adminNote    String?           @db.Text
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy Admin? @relation("WithdrawalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Transaction {
  id          String            @id @default(cuid())
  userId      String
  type        TransactionType
  amount      Float
  currency    String            @default("USD")
  status      TransactionStatus @default(PENDING)
  reference   String?
  description String?
  relatedId   String?
  createdAt   DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  body      String           @db.Text
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

/* ---------------------------------------------------------------- content */

model Page {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  content         String        @db.Text
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
}

model NavigationItem {
  id         String      @id @default(cuid())
  label      String
  url        String
  location   NavLocation @default(HEADER)
  order      Int         @default(0)
  isEnabled  Boolean     @default(true)
  isExternal Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([location, order])
}

model HomepageSection {
  id        String   @id @default(cuid())
  key       String   @unique
  eyebrow   String?
  title     String
  subtitle  String?
  content   Json?
  order     Int      @default(0)
  isEnabled Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@index([order])
}

model Stat {
  id        String   @id @default(cuid())
  label     String
  value     String
  suffix    String?
  note      String?
  order     Int      @default(0)
  isEnabled Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@index([order])
}

model Testimonial {
  id            String   @id @default(cuid())
  name          String
  role          String?
  company       String?
  quote         String   @db.Text
  avatarMediaId String?
  isEnabled     Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  avatar Media? @relation(fields: [avatarMediaId], references: [id], onDelete: SetNull)

  @@index([order])
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  category  String?
  isEnabled Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@index([category])
}

/* ------------------------------------------------------------------- blog */

model BlogCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  posts BlogPost[]

  @@index([order])
}

model BlogTag {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  posts BlogPostTag[]
}

model BlogPost {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  excerpt         String        @db.Text
  content         String        @db.Text
  coverImageUrl   String?
  coverMediaId    String?
  categoryId      String?
  authorName      String        @default("CopiPilot Desk")
  status          ContentStatus @default(DRAFT)
  isFeatured      Boolean       @default(false)
  views           Int           @default(0)
  seoTitle        String?
  seoDescription  String?
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  category BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  cover    Media?        @relation(fields: [coverMediaId], references: [id], onDelete: SetNull)
  tags     BlogPostTag[]

  @@index([status, publishedAt])
  @@index([isFeatured])
  @@index([categoryId])
}

model BlogPostTag {
  postId String
  tagId  String

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

/* ---------------------------------------------------------------- assets */

model Media {
  id           String   @id @default(cuid())
  filename     String   @unique
  originalName String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  url          String
  alt          String?
  createdAt    DateTime @default(now())

  testimonials Testimonial[]
  posts        BlogPost[]
}

/* ------------------------------------------------------------- operations */

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String        @db.Text
  status    MessageStatus @default(NEW)
  adminNote String?       @db.Text
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([entity])
  @@index([createdAt])
  @@index([adminId])
}
